# =============================================================================
# FPSI — variáveis de ambiente
# Copie para .env.local (desenvolvimento) ou configure no painel do deploy.
#   cp .env.example .env.local
# =============================================================================

# --- Obrigatórias (Supabase) -------------------------------------------------
# Dashboard → Project Settings → API
# Se omitidas, o app usa a instância de referência embutida (demo/desenvolvimento).
# Para nova implantação: preencha ou use /setup no app para gerar este arquivo.
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_chave_anon_publica

# Necessária para: cadastro por e-mail, convites, gestão de usuários (API Admin).
# Nunca exponha no frontend — use só em rotas server-side.
SUPABASE_SERVICE_ROLE_KEY=sua_chave_service_role

# --- Recomendadas ------------------------------------------------------------
# URL pública da aplicação (links em e-mails, convites, PDFs, OAuth redirect).
# Local: http://localhost:3000 | Produção FPSI: https://fpsi.com.br
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Opcionais ---------------------------------------------------------------
# IA assistida no mapeamento de dados (OpenAI).
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# E-mails transacionais (Resend) — notificações ao DPO.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=FPSI <noreply@seudominio.com.br>

# E-mails com acesso à área admin global (separados por vírgula).
# FPSI_ADMIN_EMAILS=admin@example.com

# Refine Devtools no browser (desenvolvimento).
# NEXT_PUBLIC_REFINE_DEVTOOLS=true
